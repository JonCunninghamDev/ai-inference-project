[Unit]\nDescription=Air-Gapped RAG Worker\nAfter=network-online.target\nWants=network-online.target\nStartLimitIntervalSec=0\n\n[Service]\nType=simple\nUser=rag-worker\nGroup=rag-worker\nWorkingDirectory=/opt/ai-inference\nEnvironment=ENVIRONMENT=prod\nEnvironmentFile=/opt/ai-inference/config/prod.env\nExecStart=/opt/ai-inference/venv/bin/python /opt/ai-inference/src/worker.py prod\nExecReload=/bin/kill -HUP $MAINPID\nRestart=always\nRestartSec=10\nKillMode=mixed\nKillSignal=SIGTERM\nTimeoutStopSec=30\n\n# Security settings\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nReadWritePaths=/opt/ai-inference/logs\nReadOnlyPaths=/opt/ai-inference\n\n# Resource limits\nLimitNOFILE=65536\nMemoryMax=2G\nCPUQuota=200%\n\n# Logging\nStandardOutput=journal\nStandardError=journal\nSyslogIdentifier=rag-worker\n\n[Install]\nWantedBy=multi-user.target