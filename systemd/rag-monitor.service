[Unit]\nDescription=Air-Gapped RAG Health Monitor\nAfter=rag-worker.service\nRequires=rag-worker.service\n\n[Service]\nType=simple\nUser=rag-worker\nGroup=rag-worker\nWorkingDirectory=/opt/ai-inference\nEnvironment=ENVIRONMENT=prod\nEnvironmentFile=/opt/ai-inference/config/prod.env\nExecStart=/opt/ai-inference/scripts/health_monitor.py\nRestart=always\nRestartSec=30\nKillMode=mixed\nKillSignal=SIGTERM\nTimeoutStopSec=15\n\n# Security settings\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nProtectHome=true\nReadWritePaths=/opt/ai-inference/logs\n\n# Resource limits\nLimitNOFILE=1024\nMemoryMax=256M\nCPUQuota=50%\n\n# Logging\nStandardOutput=journal\nStandardError=journal\nSyslogIdentifier=rag-health-monitor\n\n[Install]\nWantedBy=multi-user.target