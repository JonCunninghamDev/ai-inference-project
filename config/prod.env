# Production Environment Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=221278850141

# Queue Configuration
QUEUE_NAME=ai-inference-queue-Prod
DLQ_NAME=ai-inference-dlq-Prod
QUEUE_VISIBILITY_TIMEOUT=600
MAX_RECEIVE_COUNT=5

# SSM Configuration
SSM_KILL_SWITCH=/ai-inference/config/Prod/enable-processing
SSM_CONFIG_PREFIX=/ai-inference/config/Prod

# CloudWatch Configuration
LOG_GROUP_NAME=/ai-inference/worker-Prod
LOG_STREAM_NAME=prod-worker
LOG_RETENTION_DAYS=30

# vLLM Configuration
VLLM_URL=http://localhost:8000/v1
VLLM_MODEL=llama-3.1-8b
VLLM_SMALL_MODEL=
VLLM_LARGE_MODEL=
VLLM_SMALL_CONTEXT_TOKENS=4096
VLLM_LARGE_CONTEXT_TOKENS=32768
VLLM_TEMPERATURE=0.1
VLLM_MAX_TOKENS=2048

# Worker Configuration
WORKER_POLL_INTERVAL=10
WORKER_HEALTH_CHECK_INTERVAL=15
WORKER_MAX_RETRIES=5
WORKER_BACKOFF_FACTOR=1.5

# VPN Configuration
VPN_TUNNEL_CIDR=169.254.12.0/30
VPN_BGP_ASN=65000
HOME_IP=PRODUCTION_GATEWAY_IP
VPC_CIDR=10.2.0.0/16

# Security Configuration
ENCRYPTION_AT_REST=true
VPN_KEY_ROTATION_DAYS=30
SESSION_TIMEOUT_MINUTES=15

# Monitoring Configuration
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true
ALERT_EMAIL=ops-prod@company.com
# GPU scheduling
GPU_SCHEDULING_ENABLED=true
GPU_MEMORY_RESERVE_MB=1024
GPU_MAX_UTILIZATION_PERCENT=92.0
GPU_SMALL_MODEL_MEMORY_MB=8192
GPU_LARGE_MODEL_MEMORY_MB=24576
GPU_SMALL_MODEL_MAX_BATCH_SIZE=8
GPU_LARGE_MODEL_MAX_BATCH_SIZE=2
GPU_DEVICE_ID=gpu-0
GPU_DEVICE_NAME=local-gpu
GPU_DEVICE_MEMORY_MB=49152
GPU_DEVICE_USED_MEMORY_MB=0
GPU_DEVICE_UTILIZATION_PERCENT=0.0
