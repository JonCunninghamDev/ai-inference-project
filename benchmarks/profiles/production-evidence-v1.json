{
  "profile_id": "production-evidence-v1",
  "description": "First hardware-backed inference baseline; execution requires explicit GPU/cloud-spend approval.",
  "api_mode": "asynchronous_polling",
  "authorization": {
    "gpu_cloud_spend_approved": false,
    "approval_ceiling_usd": 5
  },
  "hardware": {
    "cloud": "aws",
    "region": "us-east-1",
    "instance_type": "g6.2xlarge",
    "purchase_model": "on-demand",
    "gpu": "NVIDIA L4",
    "gpu_count": 1,
    "gpu_memory_gib": 22,
    "host_memory_gib": 32,
    "instance_store_gb": 450
  },
  "runtime": {
    "vllm_version": "0.30.0",
    "container": "vllm/vllm-openai:v0.30.0",
    "ami_family": "Deep Learning Base OSS Nvidia Driver GPU AMI (Ubuntu 26.04)",
    "ami_resolution": "AWS public SSM parameter at launch time"
  },
  "model": {
    "name": "Qwen/Qwen3-4B-Instruct-2507",
    "revision": "cdbee75f17c01a7cc42f958dc650907174af0554",
    "license": "Apache-2.0",
    "repository_size_gb": 8.06
  },
  "cost_gate": {
    "captured_date": "2026-09-29",
    "ec2_on_demand_usd_per_hour": 0.9776,
    "max_session_hours": 3,
    "ec2_compute_budget_usd": 2.9328,
    "approval_ceiling_usd": 5,
    "note": "Ceiling includes buffer for root EBS and public IPv4. No commitment or reservation."
  },
  "workload": {
    "input_tokens_target": 500,
    "output_tokens_target": 100,
    "arrival_rates_rps": [
      1,
      5,
      10,
      25,
      50,
      100,
      200
    ],
    "duration_per_level": "5m",
    "poll_interval_ms": 250,
    "load_generator": {
      "expected_terminal_seconds_for_vu_planning": 5,
      "vu_headroom_multiplier": 1.25,
      "preallocated_vus_formula": "ceil(rate_rps * expected_terminal_seconds * vu_headroom_multiplier)",
      "dynamic_max_vus_enabled": false,
      "dropped_iterations_must_equal": 0,
      "note": "A rate point is invalid if k6 drops iterations; do not label load-generator saturation as service saturation."
    }
  },
  "slo_baseline": {
    "accepted_terminal_success_rate_min": 0.99,
    "terminal_latency_p95_ms_max": 60000,
    "admission_rejection_rate_max": null,
    "note": "Accepted-request terminal success excludes HTTP 429 admission rejections. Admission rejection is measured separately and may be thresholded explicitly per rate. Terminal latency is submit-to-terminal-result latency and is not TTFT."
  },
  "metric_sources": {
    "control_plane": [
      "ai_inference_gateway_requests_total",
      "ai_inference_worker_requests_total",
      "ai_inference_queue_wait_seconds",
      "ai_inference_inference_duration_seconds",
      "ai_inference_batch_size",
      "ai_inference_batch_estimated_tokens",
      "ai_inference_scheduling_decisions_total"
    ],
    "vllm": [
      "vllm:num_requests_running",
      "vllm:num_requests_waiting",
      "vllm:kv_cache_usage_perc",
      "vllm:prompt_tokens_total",
      "vllm:generation_tokens_total",
      "vllm:time_to_first_token_seconds",
      "vllm:request_time_per_output_token_seconds",
      "vllm:e2e_request_latency_seconds",
      "vllm:request_queue_time_seconds",
      "vllm:request_prefill_time_seconds",
      "vllm:request_decode_time_seconds"
    ],
    "dcgm": [
      "DCGM_FI_DEV_GPU_UTIL",
      "DCGM_FI_DEV_FB_USED",
      "DCGM_FI_DEV_FB_FREE",
      "DCGM_FI_DEV_GPU_TEMP",
      "DCGM_FI_DEV_POWER_USAGE"
    ],
    "load_generator": [
      "inference_terminal_latency_ms",
      "accepted_terminal_success",
      "inference_admission_rejected_rate",
      "inference_rejected_total",
      "unexpected_submit_failure",
      "poll_http_failure",
      "dropped_iterations",
      "http_req_duration"
    ]
  },
  "network": {
    "public_inbound_allowed": false,
    "gateway_bind_host": "127.0.0.1",
    "gateway_metrics_exposure": "loopback_only",
    "vllm_bind_host": "127.0.0.1",
    "worker_metrics_bind_host": "127.0.0.1",
    "security_group_inbound_rules": "none"
  }
}
